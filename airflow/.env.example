# Copier ce fichier en `airflow/.env` puis remplacer les valeurs.
# `airflow/.env` est ignoré par git : ne jamais le committer.

# UID de ton utilisateur Linux (commande : id -u)
AIRFLOW_UID=1000
# GID du groupe docker (commande : getent group docker | cut -d: -f3)
DOCKER_GID=999
# Image Airflow personnalisée (avec le client Docker)
AIRFLOW_IMAGE_NAME=olist-airflow:3.3.2

# Secrets Airflow : générer chacun avec la commande indiquée.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# openssl rand -base64 32
AIRFLOW__API_AUTH__JWT_SECRET=
# openssl rand -base64 32
AIRFLOW__API__SECRET_KEY=
